# Do not put API keys in this file. Use the mounted secret file instead.
CODEXIFY_IMAGE=ghcr.io/overbit/codexify:latest
# Linux: set these to the owner of the state and workspace directories (id -u/id -g).
CODEXIFY_UID=1000
CODEXIFY_GID=1000
# Default host paths are always below the OS user's HOME (not this checkout):
#   $HOME/.codexify/docker/home       - Codexify state and configuration
#   $HOME/.codexify/docker/workspace  - projects visible to Codexify
#   $HOME/.codexify/docker/secrets/openai_tunnel_api_key
# Optional overrides: uncomment and use absolute host paths.
# CODEXIFY_STATE_DIR=/absolute/path/to/codexify-home
# CODEXIFY_WORKSPACE=/absolute/path/to/projects
# CODEXIFY_TUNNEL_KEY_PATH=/absolute/path/to/openai_tunnel_api_key
CODEXIFY_MEMORY_LIMIT=2g
CODEXIFY_CPU_LIMIT=2.0
